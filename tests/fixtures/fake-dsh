#!/usr/bin/env bash
# Test double for the dsh CLI.
#
# Environment:
#   FAKE_DSH_VERSION   reported by --version
#   FAKE_DSH_STDOUT    printed on a real run (default: empty)
#   FAKE_DSH_EXIT      exit code of a real run (default: 0)
#   FAKE_DSH_ARGV_FILE one argument per line, for the last run
#   FAKE_DSH_ENV_FILE  selected environment variables, for the last run
set -u

if [ "${1:-}" = "--version" ]; then
  echo "${FAKE_DSH_VERSION:-0.2.2-rc.1}"
  exit 0
fi

if [ -n "${FAKE_DSH_ARGV_FILE:-}" ]; then
  : > "$FAKE_DSH_ARGV_FILE"
  # The argument count comes first so a multi-line prompt stays countable.
  printf '#argc=%s\n' "$#" >> "$FAKE_DSH_ARGV_FILE"
  for arg in "$@"; do
    printf '%s\n' "$arg" >> "$FAKE_DSH_ARGV_FILE"
  done
fi

if [ -n "${FAKE_DSH_ENV_FILE:-}" ]; then
  {
    printf 'DSH_HOME=%s\n' "${DSH_HOME:-}"
    printf 'DSH_PERMISSION_MODE=%s\n' "${DSH_PERMISSION_MODE:-}"
    printf 'DSH_TELEMETRY_DISABLED=%s\n' "${DSH_TELEMETRY_DISABLED:-}"
    printf 'GATELLM_REVIEW_API_KEY=%s\n' "${GATELLM_REVIEW_API_KEY:-}"
    printf 'PWD=%s\n' "$PWD"
  } > "$FAKE_DSH_ENV_FILE"
fi

[ -n "${FAKE_DSH_STDOUT:-}" ] && printf '%s\n' "$FAKE_DSH_STDOUT"
exit "${FAKE_DSH_EXIT:-0}"
